{
  "name": "assessment-integrity-agent-backend",
  "version": "1.0.0",
  "description": "Assessment Integrity Agent Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.json -r tsconfig-paths/register src/server.ts",
    "build": "tsc --project tsconfig.json && tsc-alias && esbuild dist/server.js --bundle --platform=node --target=node20 --outfile=dist/server.js --allow-overwrite --external:pg --external:@prisma/client --external:express --external:cors --external:socket.io --external:multer --external:nodemailer --external:jpeg-js --external:pdf-parse --external:tesseract.js --external:mammoth --external:swagger-ui-express",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint": "biome lint ./src",
    "format": "biome format ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "test": "vitest run src"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@better-fetch/fetch": "1.3.1",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "better-auth": "^1.6.14",
    "better-call": "1.3.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jpeg-js": "^0.4.4",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.1",
    "openai": "^6.45.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "tsc-alias": "^1.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.0",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.28.1",
    "prisma": "^7.8.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
